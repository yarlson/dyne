#!/usr/bin/env bash
set -euo pipefail

export PATH="${MISE_DATA_DIR:-/home/agent/.local/share/mise}/shims:/home/agent/.local/bin:${PATH}"

seed_auth() {
  mkdir -p "${CODEX_HOME}"
  if [[ ! -f "${CODEX_HOME}/auth.json" && -f /var/run/agent-auth/auth.json ]]; then
    install -m 600 /var/run/agent-auth/auth.json "${CODEX_HOME}/auth.json"
  fi
}

load_api_key() {
  if [[ -f /var/run/agent-auth/CODEX_API_KEY ]]; then
    CODEX_API_KEY="$(< /var/run/agent-auth/CODEX_API_KEY)"
    export CODEX_API_KEY
  fi
}

initialize_workspace() {
  mkdir -p /workspace "${HOME}/.cache/npm" "${MISE_DATA_DIR}" "${MISE_CACHE_DIR}"
  if ! git config --global --get-all safe.directory | grep -Fxq /workspace; then
    git config --global --add safe.directory /workspace
  fi
  if [[ -n "${AGENT_SETUP:-}" ]]; then
    cd /workspace
    bash -lc "${AGENT_SETUP}"
  fi
}

clone_workspace() {
  if [[ -d /workspace/.git ]]; then
    if [[ ! -f /artifacts/base-commit ]]; then
      git -C /workspace rev-parse HEAD > /artifacts/base-commit
    fi
    return
  fi
  if find /workspace -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    printf 'workspace is not empty and is not a Git repository\n' >&2
    exit 1
  fi
  if [[ -z "${AGENT_REPOSITORY:-}" ]]; then
    git init /workspace
    return
  fi
  local -a clone_args=(clone --branch "${AGENT_REF}")
  if [[ "${AGENT_CLONE_DEPTH:-0}" -gt 0 ]]; then
    clone_args+=(--depth "${AGENT_CLONE_DEPTH}" --single-branch)
  fi
  clone_args+=(-- "${AGENT_REPOSITORY}" /workspace)
  if [[ -f /var/run/git-auth/token ]]; then
    GIT_ASKPASS=/usr/local/bin/git-askpass GIT_TERMINAL_PROMPT=0 git "${clone_args[@]}"
  else
    GIT_TERMINAL_PROMPT=0 git "${clone_args[@]}"
  fi
  git -C /workspace rev-parse HEAD > /artifacts/base-commit
}

validate_change_file() {
  local path="$1" expected_sha="$2" expected_bytes="$3"
  if [[ ! "${expected_sha}" =~ ^[0-9a-f]{64}$ || ! "${expected_bytes}" =~ ^[1-9][0-9]*$ ]]; then
    return 1
  fi
  local actual_sha actual_bytes
  actual_sha="$(sha256sum "${path}" | awk '{print $1}')"
  actual_bytes="$(wc -c < "${path}")"
  [[ "${actual_sha}" == "${expected_sha}" && "${actual_bytes}" == "${expected_bytes}" ]]
}

apply_change() {
  : "${CHANGE_SHA256:?CHANGE_SHA256 is required}"
  : "${CHANGE_BYTES:?CHANGE_BYTES is required}"
  local change_path="/change/changes/${CHANGE_SHA256}.patch"
  validate_change_file "${change_path}" "${CHANGE_SHA256}" "${CHANGE_BYTES}"
  cd /workspace
  git apply --index --binary "${change_path}"
}

create_change_artifact() {
  if [[ ! -f /artifacts/outcome.json ]]; then
    return
  fi
  local outcome_status
  outcome_status="$(node -e 'process.stdout.write(String(JSON.parse(require("fs").readFileSync("/artifacts/outcome.json", "utf8")).status || ""))' 2>/dev/null || true)"
  if [[ "${outcome_status}" != "completed" ]]; then
    rm -f /artifacts/change.patch /artifacts/change.json
    return
  fi
  if [[ "${AGENT_RESULT_KIND:-pull-request}" != "workflow-change" && ! ( "${AGENT_RESULT_KIND:-pull-request}" == "pull-request" && "${AGENT_STORAGE:-}" == "persistent" ) ]]; then
    return
  fi
  local base_commit
  base_commit="$(< /artifacts/base-commit)"
  cd /workspace
  git add -A
  git diff --cached --binary --full-index "${base_commit}" -- > /artifacts/change.patch
  local change_sha change_bytes
  change_sha="$(sha256sum /artifacts/change.patch | awk '{print $1}')"
  change_bytes="$(wc -c < /artifacts/change.patch)"
  mkdir -p /artifacts/changes
  local retained_change="/artifacts/changes/${change_sha}.patch"
  if [[ -f "${retained_change}" ]]; then
    validate_change_file "${retained_change}" "${change_sha}" "${change_bytes}"
    rm -f /artifacts/change.patch
  else
    mv /artifacts/change.patch "${retained_change}"
  fi
  node -e 'require("fs").writeFileSync("/artifacts/change.json", JSON.stringify({sha256:process.argv[1],bytes:Number(process.argv[2])}) + "\n")' "${change_sha}" "${change_bytes}"
}

publish_workspace() {
  : "${PUBLISH_REPOSITORY:?PUBLISH_REPOSITORY is required}"
  : "${PUBLISH_BASE:?PUBLISH_BASE is required}"
  : "${PUBLISH_BRANCH:?PUBLISH_BRANCH is required}"
  : "${PUBLISH_COMMIT_MESSAGE:?PUBLISH_COMMIT_MESSAGE is required}"
  : "${PUBLISH_AUTHOR_NAME:?PUBLISH_AUTHOR_NAME is required}"
  : "${PUBLISH_AUTHOR_EMAIL:?PUBLISH_AUTHOR_EMAIL is required}"
  if [[ ! -f /var/run/git-auth/token ]]; then
    printf 'GitHub token is required\n' >&2
    exit 1
  fi
  validate_pull_request_artifact
  git check-ref-format --branch "${PUBLISH_BRANCH}" >/dev/null
  if find /publish -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    printf 'publish workspace is not empty\n' >&2
    exit 1
  fi
  git_publish clone --branch "${PUBLISH_BASE}" --depth 1 --single-branch -- "${PUBLISH_REPOSITORY}" /publish
  cd /publish
  if [[ -n "${PUBLISH_CHANGE_SHA256:-}" ]]; then
    : "${PUBLISH_CHANGE_BYTES:?PUBLISH_CHANGE_BYTES is required}"
    local change_path="/artifacts/changes/${PUBLISH_CHANGE_SHA256}.patch"
    validate_change_file "${change_path}" "${PUBLISH_CHANGE_SHA256}" "${PUBLISH_CHANGE_BYTES}"
    git_publish apply --index --binary "${change_path}"
  else
    find /publish -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf -- {} +
    find /workspace -mindepth 1 -maxdepth 1 ! -name .git -printf '%P\0' \
      | tar --null --directory=/workspace --files-from=- --create --file=- \
      | tar --directory=/publish --extract --file=-
  fi
  if [[ -z "$(git_publish status --porcelain=v1 --untracked-files=normal)" ]]; then
    printf 'workspace has no changes relative to %s\n' "${PUBLISH_BASE}" >&2
    exit 1
  fi
  git_publish switch -c "${PUBLISH_BRANCH}"
  git_publish add -A
  git_publish -c "user.name=${PUBLISH_AUTHOR_NAME}" -c "user.email=${PUBLISH_AUTHOR_EMAIL}" commit -m "${PUBLISH_COMMIT_MESSAGE}"
  local commit_sha remote_sha
  commit_sha="$(git_publish rev-parse HEAD)"
  printf 'branch=%s\ncommit=%s\n' "${PUBLISH_BRANCH}" "${commit_sha}" > /dev/termination-log
  if ! git_publish push --porcelain -- "${PUBLISH_REPOSITORY}" "HEAD:refs/heads/${PUBLISH_BRANCH}"; then
    remote_sha="$(git_publish ls-remote --heads -- "${PUBLISH_REPOSITORY}" "refs/heads/${PUBLISH_BRANCH}" | awk 'NR == 1 { print $1 }')"
    if [[ "${remote_sha}" != "${commit_sha}" ]]; then
      printf 'push failed and remote branch does not match commit %s\n' "${commit_sha}" >&2
      exit 1
    fi
  fi
  remote_sha="$(git_publish ls-remote --heads -- "${PUBLISH_REPOSITORY}" "refs/heads/${PUBLISH_BRANCH}" | awk 'NR == 1 { print $1 }')"
  if [[ "${remote_sha}" != "${commit_sha}" ]]; then
    printf 'remote branch points to %s instead of %s\n' "${remote_sha:-nothing}" "${commit_sha}" >&2
    exit 1
  fi
  local pull_title pull_body
  pull_title="$(node -e 'process.stdout.write(Buffer.from(JSON.parse(require("fs").readFileSync("/artifacts/pull-request.json", "utf8")).title).toString("base64"))')"
  pull_body="$(node -e 'process.stdout.write(Buffer.from(JSON.parse(require("fs").readFileSync("/artifacts/pull-request.json", "utf8")).body).toString("base64"))')"
  printf 'branch=%s\ncommit=%s\ntitle=%s\nbody=%s\n' "${PUBLISH_BRANCH}" "${commit_sha}" "${pull_title}" "${pull_body}" > /dev/termination-log
}

validate_pull_request_artifact() {
  node -e '
const pull = JSON.parse(require("fs").readFileSync("/artifacts/pull-request.json", "utf8"));
if (typeof pull.title !== "string" || !pull.title.trim() || pull.title.includes("\n") || pull.title.length > 256 || typeof pull.body !== "string" || !pull.body.trim() || pull.body.length > 2000) process.exit(1);
' 2>/dev/null
}

git_publish() {
  GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_ASKPASS=/usr/local/bin/git-askpass \
    GIT_TERMINAL_PROMPT=0 \
    git -c safe.directory=/publish -c core.hooksPath=/dev/null "$@"
}

run_task() {
  load_api_key
  rm -f /artifacts/outcome.json /artifacts/pull-request.json /artifacts/workflow-output.json /artifacts/change.patch /artifacts/change.json
  local -a args=(exec --dangerously-bypass-approvals-and-sandbox --json --cd /workspace)
  if [[ -n "${AGENT_INSTRUCTIONS:-}" ]]; then
    local encoded_instructions
    encoded_instructions="$(node -e 'process.stdout.write(JSON.stringify(process.env.AGENT_INSTRUCTIONS))')"
    args+=(-c "developer_instructions=${encoded_instructions}")
  fi
  if [[ "${AGENT_STORAGE:-}" == "ephemeral" ]]; then
    args+=(--ephemeral)
  fi
  if [[ "${AGENT_RESUME:-false}" == "true" ]]; then
    args+=(resume --last)
  fi

  local contract result_contract task_status
  if [[ "${AGENT_RESULT_KIND:-pull-request}" == "workflow-output" || "${AGENT_RESULT_KIND:-pull-request}" == "workflow-change" ]]; then
    result_contract='For completed work, also write /artifacts/workflow-output.json as a JSON object no larger than 1400 bytes.'
  else
    result_contract='For completed work, also write /artifacts/pull-request.json as JSON with non-empty title and body strings.'
  fi
  contract=$'\n\nBefore you finish, write /artifacts/outcome.json as JSON with status (completed or blocked), summary, and blocker. Use an empty blocker when completed. '"${result_contract}"$' Do not claim completion when a sandbox limit, missing information, or another blocker prevents the task.'
  set +e
  codex "${args[@]}" "${AGENT_TASK}${contract}" 2>&1 | tee -a "/logs/${AGENT_TASK_ID}.ndjson"
  task_status=${PIPESTATUS[0]}
  set -e
  if [[ ${task_status} -ne 0 ]]; then
    node -e 'const fs=require("fs"); fs.writeFileSync("/artifacts/outcome.json", JSON.stringify({status:"failed",summary:"coding agent exited unsuccessfully",blocker:"agent process exited with status "+process.argv[1]})+"\n")' "${task_status}"
    report_task_artifacts
    return "${task_status}"
  fi

  create_change_artifact
  if validate_task_artifacts; then
    report_task_artifacts
    return
  fi

  codex exec --dangerously-bypass-approvals-and-sandbox --json --cd /workspace resume --last "The task result artifacts are missing or invalid. Recreate /artifacts/outcome.json with status (completed or blocked), summary, and blocker strings. ${result_contract} Preserve an honest blocked result when work cannot be completed." 2>&1 | tee -a "/logs/${AGENT_TASK_ID}.ndjson"
  create_change_artifact
  validate_task_artifacts
  report_task_artifacts
}

validate_task_artifacts() {
  if [[ -f /artifacts/change.json ]]; then
    local change_sha change_bytes
    change_sha="$(node -e 'process.stdout.write(String(JSON.parse(require("fs").readFileSync("/artifacts/change.json", "utf8")).sha256 || ""))' 2>/dev/null || true)"
    change_bytes="$(node -e 'process.stdout.write(String(JSON.parse(require("fs").readFileSync("/artifacts/change.json", "utf8")).bytes || ""))' 2>/dev/null || true)"
    validate_change_file "/artifacts/changes/${change_sha}.patch" "${change_sha}" "${change_bytes}" || return 1
  fi
  node -e '
const fs = require("fs");
const read = path => JSON.parse(fs.readFileSync(path, "utf8"));
const outcome = read("/artifacts/outcome.json");
if (!["completed", "blocked"].includes(outcome.status) || typeof outcome.summary !== "string" || !outcome.summary.trim() || outcome.summary.length > 512 || typeof outcome.blocker !== "string" || outcome.blocker.length > 512) process.exit(1);
if (outcome.status === "blocked") {
  if (!outcome.blocker.trim()) process.exit(1);
  process.exit(0);
}
if (["workflow-output", "workflow-change"].includes(process.env.AGENT_RESULT_KIND || "pull-request")) {
  const output = read("/artifacts/workflow-output.json");
  if (!output || Array.isArray(output) || typeof output !== "object" || Buffer.byteLength(JSON.stringify(output)) > 1400) process.exit(1);
  if ((process.env.AGENT_RESULT_KIND || "pull-request") === "workflow-output") process.exit(0);
} else {
  const pull = read("/artifacts/pull-request.json");
  if (typeof pull.title !== "string" || !pull.title.trim() || pull.title.includes("\n") || pull.title.length > 256 || typeof pull.body !== "string" || !pull.body.trim() || pull.body.length > 2000) process.exit(1);
}
if ((process.env.AGENT_RESULT_KIND || "pull-request") === "workflow-change" || ((process.env.AGENT_RESULT_KIND || "pull-request") === "pull-request" && process.env.AGENT_STORAGE === "persistent")) {
  const change = read("/artifacts/change.json");
  if (!/^[0-9a-f]{64}$/.test(change.sha256) || !Number.isSafeInteger(change.bytes) || change.bytes <= 0) process.exit(1);
}
' 2>/dev/null
}

report_task_artifacts() {
  node -e '
const fs = require("fs");
const lines = ["outcome=" + fs.readFileSync("/artifacts/outcome.json").toString("base64")];
if (fs.existsSync("/artifacts/pull-request.json")) lines.push("pull-request=" + fs.readFileSync("/artifacts/pull-request.json").toString("base64"));
if (fs.existsSync("/artifacts/workflow-output.json")) lines.push("workflow-output=" + fs.readFileSync("/artifacts/workflow-output.json").toString("base64"));
if (fs.existsSync("/artifacts/change.json")) lines.push("change=" + fs.readFileSync("/artifacts/change.json").toString("base64"));
let message = lines.join("\n") + "\n";
if (Buffer.byteLength(message) > 4096) {
  const outcome = Buffer.from(JSON.stringify({status:"failed",summary:"task result artifacts exceeded the Kubernetes termination message limit",blocker:"reduce the task result artifact size"}) + "\n").toString("base64");
  message = "outcome=" + outcome + "\n";
  fs.writeFileSync("/dev/termination-log", message);
  process.exit(1);
}
fs.writeFileSync("/dev/termination-log", message);
'
}

case "${1:-}" in
  clone)
    clone_workspace
    ;;
  apply-change)
    apply_change
    ;;
  init)
    initialize_workspace
    ;;
  auth)
    seed_auth
    ;;
  publish)
    publish_workspace
    ;;
  run)
    run_task
    ;;
  idle)
    exec sleep infinity
    ;;
  *)
    printf 'usage: agent-entrypoint <clone|apply-change|init|auth|publish|run|idle>\n' >&2
    exit 2
    ;;
esac
