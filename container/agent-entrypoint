#!/usr/bin/env bash
set -euo pipefail

export PATH="${MISE_DATA_DIR:-/home/agent/.local/share/mise}/shims:/home/agent/.local/bin:${PATH}"

seed_auth() {
  mkdir -p "${CODEX_HOME}"
  if [[ ! -f "${CODEX_HOME}/auth.json" && -f /var/run/agent-auth/auth.json ]]; then
    install -m 600 /var/run/agent-auth/auth.json "${CODEX_HOME}/auth.json"
  fi
}

load_api_key() {
  if [[ -f /var/run/agent-auth/CODEX_API_KEY ]]; then
    CODEX_API_KEY="$(< /var/run/agent-auth/CODEX_API_KEY)"
    export CODEX_API_KEY
  fi
}

initialize_workspace() {
  mkdir -p /workspace "${HOME}/.cache/npm" "${MISE_DATA_DIR}" "${MISE_CACHE_DIR}"
  if ! git config --global --get-all safe.directory | grep -Fxq /workspace; then
    git config --global --add safe.directory /workspace
  fi
  if [[ -n "${AGENT_SETUP:-}" ]]; then
    cd /workspace
    bash -lc "${AGENT_SETUP}"
  fi
}

clone_workspace() {
  if [[ -d /workspace/.git ]]; then
    return
  fi
  if find /workspace -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    printf 'workspace is not empty and is not a Git repository\n' >&2
    exit 1
  fi
  if [[ -z "${AGENT_REPOSITORY:-}" ]]; then
    git init /workspace
    return
  fi
  local -a clone_args=(clone --branch "${AGENT_REF}")
  if [[ "${AGENT_CLONE_DEPTH:-0}" -gt 0 ]]; then
    clone_args+=(--depth "${AGENT_CLONE_DEPTH}" --single-branch)
  fi
  clone_args+=(-- "${AGENT_REPOSITORY}" /workspace)
  if [[ -f /var/run/git-auth/token ]]; then
    GIT_ASKPASS=/usr/local/bin/git-askpass GIT_TERMINAL_PROMPT=0 git "${clone_args[@]}"
    return
  fi
  GIT_TERMINAL_PROMPT=0 git "${clone_args[@]}"
}

publish_workspace() {
  : "${PUBLISH_REPOSITORY:?PUBLISH_REPOSITORY is required}"
  : "${PUBLISH_BASE:?PUBLISH_BASE is required}"
  : "${PUBLISH_BRANCH:?PUBLISH_BRANCH is required}"
  : "${PUBLISH_COMMIT_MESSAGE:?PUBLISH_COMMIT_MESSAGE is required}"
  : "${PUBLISH_AUTHOR_NAME:?PUBLISH_AUTHOR_NAME is required}"
  : "${PUBLISH_AUTHOR_EMAIL:?PUBLISH_AUTHOR_EMAIL is required}"
  if [[ ! -f /var/run/git-auth/token ]]; then
    printf 'GitHub token is required\n' >&2
    exit 1
  fi
  validate_pull_request_artifact
  git check-ref-format --branch "${PUBLISH_BRANCH}" >/dev/null
  if find /publish -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    printf 'publish workspace is not empty\n' >&2
    exit 1
  fi
  git_publish clone --branch "${PUBLISH_BASE}" --depth 1 --single-branch -- "${PUBLISH_REPOSITORY}" /publish
  find /publish -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf -- {} +
  find /workspace -mindepth 1 -maxdepth 1 ! -name .git -printf '%P\0' \
    | tar --null --directory=/workspace --files-from=- --create --file=- \
    | tar --directory=/publish --extract --file=-
  cd /publish
  if [[ -z "$(git_publish status --porcelain=v1 --untracked-files=normal)" ]]; then
    printf 'workspace has no changes relative to %s\n' "${PUBLISH_BASE}" >&2
    exit 1
  fi
  git_publish switch -c "${PUBLISH_BRANCH}"
  git_publish add -A
  git_publish -c "user.name=${PUBLISH_AUTHOR_NAME}" -c "user.email=${PUBLISH_AUTHOR_EMAIL}" commit -m "${PUBLISH_COMMIT_MESSAGE}"
  local commit_sha remote_sha
  commit_sha="$(git_publish rev-parse HEAD)"
  if ! git_publish push --porcelain -- "${PUBLISH_REPOSITORY}" "HEAD:refs/heads/${PUBLISH_BRANCH}"; then
    remote_sha="$(git_publish ls-remote --heads -- "${PUBLISH_REPOSITORY}" "refs/heads/${PUBLISH_BRANCH}" | awk 'NR == 1 { print $1 }')"
    if [[ "${remote_sha}" != "${commit_sha}" ]]; then
      printf 'push failed and remote branch does not match commit %s\n' "${commit_sha}" >&2
      exit 1
    fi
  fi
  remote_sha="$(git_publish ls-remote --heads -- "${PUBLISH_REPOSITORY}" "refs/heads/${PUBLISH_BRANCH}" | awk 'NR == 1 { print $1 }')"
  if [[ "${remote_sha}" != "${commit_sha}" ]]; then
    printf 'remote branch points to %s instead of %s\n' "${remote_sha:-nothing}" "${commit_sha}" >&2
    exit 1
  fi
  local pull_title pull_body
  pull_title="$(node -e 'process.stdout.write(Buffer.from(JSON.parse(require("fs").readFileSync("/artifacts/pull-request.json", "utf8")).title).toString("base64"))')"
  pull_body="$(node -e 'process.stdout.write(Buffer.from(JSON.parse(require("fs").readFileSync("/artifacts/pull-request.json", "utf8")).body).toString("base64"))')"
  printf 'branch=%s\ncommit=%s\ntitle=%s\nbody=%s\n' "${PUBLISH_BRANCH}" "${commit_sha}" "${pull_title}" "${pull_body}" > /dev/termination-log
}

validate_pull_request_artifact() {
  node -e '
const pull = JSON.parse(require("fs").readFileSync("/artifacts/pull-request.json", "utf8"));
if (typeof pull.title !== "string" || !pull.title.trim() || pull.title.includes("\n") || pull.title.length > 256 || typeof pull.body !== "string" || !pull.body.trim() || pull.body.length > 2000) process.exit(1);
' 2>/dev/null
}

git_publish() {
  GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_ASKPASS=/usr/local/bin/git-askpass \
    GIT_TERMINAL_PROMPT=0 \
    git -c safe.directory=/publish -c core.hooksPath=/dev/null "$@"
}

run_task() {
  load_api_key
  rm -f /artifacts/outcome.json /artifacts/pull-request.json
  local -a args=(exec --dangerously-bypass-approvals-and-sandbox --json --cd /workspace)
  if [[ -n "${AGENT_INSTRUCTIONS:-}" ]]; then
    local encoded_instructions
    encoded_instructions="$(node -e 'process.stdout.write(JSON.stringify(process.env.AGENT_INSTRUCTIONS))')"
    args+=(-c "developer_instructions=${encoded_instructions}")
  fi
  if [[ "${AGENT_STORAGE:-}" == "ephemeral" ]]; then
    args+=(--ephemeral)
  fi
  if [[ "${AGENT_RESUME:-false}" == "true" ]]; then
    args+=(resume --last)
  fi

  local contract task_status
  contract=$'\n\nBefore you finish, write /artifacts/outcome.json as JSON with status (completed or blocked), summary, and blocker. Use an empty blocker when completed. For completed work, also write /artifacts/pull-request.json as JSON with non-empty title and body strings. Do not claim completion when a sandbox limit, missing information, or another blocker prevents the task.'
  set +e
  codex "${args[@]}" "${AGENT_TASK}${contract}" 2>&1 | tee -a "/logs/${AGENT_TASK_ID}.ndjson"
  task_status=${PIPESTATUS[0]}
  set -e
  if [[ ${task_status} -ne 0 ]]; then
    node -e 'const fs=require("fs"); fs.writeFileSync("/artifacts/outcome.json", JSON.stringify({status:"failed",summary:"coding agent exited unsuccessfully",blocker:"agent process exited with status "+process.argv[1]})+"\n")' "${task_status}"
    report_task_artifacts
    return "${task_status}"
  fi

  if validate_task_artifacts; then
    report_task_artifacts
    return
  fi

  codex exec --dangerously-bypass-approvals-and-sandbox --json --cd /workspace resume --last $'The task result artifacts are missing or invalid. Recreate /artifacts/outcome.json. It must contain status (completed or blocked), summary, and blocker strings. If status is completed, recreate /artifacts/pull-request.json with non-empty title and body strings. Preserve an honest blocked result when work cannot be completed.' 2>&1 | tee -a "/logs/${AGENT_TASK_ID}.ndjson"
  validate_task_artifacts
  report_task_artifacts
}

validate_task_artifacts() {
  node -e '
const fs = require("fs");
const read = path => JSON.parse(fs.readFileSync(path, "utf8"));
const outcome = read("/artifacts/outcome.json");
if (!["completed", "blocked"].includes(outcome.status) || typeof outcome.summary !== "string" || !outcome.summary.trim() || outcome.summary.length > 512 || typeof outcome.blocker !== "string" || outcome.blocker.length > 512) process.exit(1);
if (outcome.status === "blocked") {
  if (!outcome.blocker.trim()) process.exit(1);
  process.exit(0);
}
const pull = read("/artifacts/pull-request.json");
if (typeof pull.title !== "string" || !pull.title.trim() || pull.title.includes("\n") || pull.title.length > 256 || typeof pull.body !== "string" || !pull.body.trim() || pull.body.length > 2000) process.exit(1);
' 2>/dev/null
}

report_task_artifacts() {
  node -e '
const fs = require("fs");
const lines = ["outcome=" + fs.readFileSync("/artifacts/outcome.json").toString("base64")];
if (fs.existsSync("/artifacts/pull-request.json")) lines.push("pull-request=" + fs.readFileSync("/artifacts/pull-request.json").toString("base64"));
fs.writeFileSync("/dev/termination-log", lines.join("\n") + "\n");
'
}

case "${1:-}" in
  clone)
    clone_workspace
    ;;
  init)
    initialize_workspace
    ;;
  auth)
    seed_auth
    ;;
  publish)
    publish_workspace
    ;;
  run)
    run_task
    ;;
  idle)
    exec sleep infinity
    ;;
  *)
    printf 'usage: agent-entrypoint <clone|init|auth|publish|run|idle>\n' >&2
    exit 2
    ;;
esac
